{
    "name": "storybook-mcp",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    },
    "scripts": {
        "dev:vite": "vite --host",
        "dev:vite:scan": "vite --host --mode scan",
        "dev:tsc": "tsc --build --watch",
        "dev": "pnpm run --parallel \"/^dev:(vite|tsc)$/\"",
        "dev:scan": "pnpm run --parallel dev:vite:scan dev:tsc",
        "build": "vite build",
        "preview": "vite preview --host",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:storybook": "vitest run --project=storybook",
        "vrt": "node --env-file-if-exists=.env.local visual/run.ts",
        "vrt:browser": "docker compose -f visual/docker-compose.yml up -d --wait",
        "vrt:browser:stop": "docker compose -f visual/docker-compose.yml down",
        "knip": "knip",
        "tsc": "tsc --build",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"**/*.{js,ts,tsx,cjs,mjs}\"",
        "lint:stylelint": "stylelint --cache -q --allow-empty-input \"**/*.css\"",
        "lint:fmt": "prettier --check \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "lint": "pnpm run \"/^lint:.*/\"",
        "fix:fmt": "prettier --write \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "prepare": "husky",
        "chromatic": "chromatic"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@casl/ability": "7.1.3",
        "@casl/react": "7.1.0",
        "@react-hookz/web": "26.1.0",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.107.1",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-virtual": "3.14.26",
        "class-variance-authority": "0.7.1",
        "cn": "0.5.2",
        "country-flag-icons": "1.6.20",
        "ky": "2.2.0",
        "libphonenumber-js": "1.13.17",
        "luxon": "3.7.2",
        "motion": "14.14.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-error-boundary": "6.1.6",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@argos-ci/storybook": "6.4.2",
        "@babel/core": "8.1.2",
        "@chromatic-com/storybook": "5.6.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/types": "21.2.3",
        "@eslint-react/eslint-plugin": "5.30.3",
        "@eslint/js": "10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@rolldown/plugin-babel": "0.2.4",
        "@storybook/addon-a11y": "11.0.0-beta.3",
        "@storybook/addon-designs": "12.0.0",
        "@storybook/addon-docs": "11.0.0-beta.3",
        "@storybook/addon-mcp": "11.0.0-beta.3",
        "@storybook/addon-vitest": "11.0.0-beta.3",
        "@storybook/react-vite": "11.0.0-beta.3",
        "@stylistic/eslint-plugin": "5.10.0",
        "@svgr/plugin-jsx": "8.1.0",
        "@svgr/plugin-svgo": "8.1.0",
        "@tailwindcss/vite": "4.3.5",
        "@tanstack/eslint-plugin-query": "5.107.1",
        "@tanstack/eslint-plugin-router": "1.162.0",
        "@tanstack/react-query-devtools": "5.107.1",
        "@tanstack/react-router-devtools": "1.167.3",
        "@tanstack/router-plugin": "1.169.0",
        "@types/babel__core": "7.20.5",
        "@types/luxon": "3.7.6",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/browser": "5.1.1",
        "@vitest/browser-playwright": "5.1.1",
        "@vitest/coverage-v8": "5.1.1",
        "babel-plugin-react-compiler": "1.0.0",
        "chromatic": "18.15.1",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsx-a11y-x": "0.2.0",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "husky": "9.1.7",
        "knip": "6.45.1",
        "msw": "3.0.6",
        "playwright": "1.65.1",
        "prettier": "3.10.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "rollup-plugin-visualizer": "7.1.3",
        "storybook": "11.0.0-beta.3",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "tailwindcss": "4.3.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vite": "8.3.8",
        "vite-plugin-html": "3.2.2",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.1.1"
    }
}
