{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "types": ["vite/client", "node", "@vitest/browser-playwright"],
        "rootDir": ".",
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.storybook.tsbuildinfo"
    },
    // visual/*/setup.ts + spec.ts run in the Vitest browser alongside stories (visual/README.md).
    "include": [
        ".storybook/*.ts",
        ".storybook/*.tsx",
        "src/**/*.stories.tsx",
        "src/vite-env.d.ts",
        "visual/*/setup.ts",
        "visual/figma/spec.ts",
        "visual/figma/colors.ts",
        "visual/figma/manifests.ts",
        "visual/figma/FigmaMatrix.tsx",
        "visual/figma/content.tsx"
    ],
    // Reset the stories exclude inherited from tsconfig.app.json.
    "exclude": []
}
